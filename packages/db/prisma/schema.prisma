generator client {
  provider   = "prisma-client-js"
  output     = "../generated/client"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Verdict {
  ignore
  watch
  enter
}

enum Persona {
  degen
  momentum
  risk_first
}

enum LaunchStatus {
  discovering
  tracked
  archived
}

enum TrackingTier {
  cold
  warm
  hot
}

enum Severity {
  info
  warn
  critical
}

enum OperationalEventType {
  worker_started
  worker_stopped
  heartbeat_stale
  stream_reconnect
  stream_error
  memo_failure
  telegram_failure
  recovery_complete
  deploy
  action_executed
  action_failed
}

enum ActionRequestStatus {
  proposed
  approved
  rejected
  executing
  executed
  failed
}

enum ActionRiskLevel {
  low
  medium
  high
}

enum ActionType {
  worker_restart
  rollback
  health_verify
}

model Launch {
  id                String           @id @default(cuid())
  chainName         String
  protocol          String
  protocolVersion   String?
  txHash            String?
  eventName         String?
  deployerAddress   String?
  pairAddress       String           @unique
  pairName          String?
  baseTokenAddress  String
  baseTokenName     String?
  baseTokenSymbol   String
  quoteTokenAddress String
  quoteTokenName    String?
  quoteTokenSymbol String
  supply           Float?
  devHoldings      Float?
  firstSeenAt       DateTime
  lastSeenAt        DateTime?
  currentStatus     LaunchStatus     @default(discovering)
  trackingTier      TrackingTier     @default(cold)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  events            LaunchEvent[]
  pairCandles       LaunchPairCandle[]
  tokenCandles      LaunchTokenCandle[]
  state             LaunchState?
  timelines         LaunchTimeline[]
  recommendations   Recommendation[]
  alerts            Alert[]
  memos             LaunchMemo[]
  alertDeliveries   AlertDelivery[]
}

model LaunchEvent {
  id           String   @id @default(cuid())
  launchId     String
  eventType    String
  eventTime    DateTime
  sourceStream String
  payloadJson  String
  ingestedAt   DateTime @default(now())
  launch       Launch   @relation(fields: [launchId], references: [id], onDelete: Cascade)

  @@index([launchId, eventTime])
}

model LaunchState {
  launchId            String   @id
  lastEventAt         DateTime
  lastPairCandleAt    DateTime?
  lastTokenCandleAt   DateTime?
  currentQuoteRate    Float?
  currentQuoteRateUsd Float?
  currentLiquidityUsd Float?
  currentVolume1mUsd  Float?
  currentMarketCapUsd Float?
  currentVolume5mUsd  Float?
  currentVolume15mUsd Float?
  currentVolume1hUsd  Float?
  priceChange1mPct    Float?
  currentSwapCount5m  Int?
  currentSwapCount1h  Int?
  priceChange5mPct    Float?
  priceChange15mPct   Float?
  priceChange1hPct    Float?
  scoreGlobal         Int      @default(0)
  delta1m             Int      @default(0)
  delta5m             Int      @default(0)
  delta15m            Int      @default(0)
  delta1h             Int      @default(0)
  verdictGlobal       Verdict  @default(ignore)
  verdictMomentum     Verdict  @default(ignore)
  verdictDegen        Verdict  @default(ignore)
  verdictRiskFirst    Verdict  @default(ignore)
  reasonCodesJson     String?
  invalidatorsJson    String?
  updatedAt           DateTime @updatedAt
  launch              Launch   @relation(fields: [launchId], references: [id], onDelete: Cascade)
}

model LaunchTimeline {
  id          String   @id @default(cuid())
  launchId    String
  timeBucket  String
  title       String
  summary     String
  severity    Severity @default(info)
  detailsJson String?
  createdAt   DateTime @default(now())
  launch      Launch   @relation(fields: [launchId], references: [id], onDelete: Cascade)

  @@index([launchId, createdAt])
}

model LaunchPairCandle {
  id           String   @id @default(cuid())
  launchId      String
  interval      String
  timeframe     String
  timestamp     DateTime
  open          Float
  high          Float
  low           Float
  close         Float
  volume        Float?
  volumeUsd     Float?
  quoteRate     Float?
  quoteRateUsd  Float?
  createdAt     DateTime @default(now())
  launch        Launch   @relation(fields: [launchId], references: [id], onDelete: Cascade)

  @@unique([launchId, interval, timeframe, timestamp])
  @@index([launchId, timestamp])
}

model LaunchTokenCandle {
  id                 String   @id @default(cuid())
  launchId           String
  primaryPairAddress String?
  interval           String
  timeframe          String
  timestamp          DateTime
  open               Float
  high               Float
  low                Float
  close              Float
  volume             Float?
  volumeUsd          Float?
  quoteRate          Float?
  quoteRateUsd       Float?
  createdAt          DateTime @default(now())
  launch             Launch   @relation(fields: [launchId], references: [id], onDelete: Cascade)

  @@unique([launchId, interval, timeframe, timestamp])
  @@index([launchId, timestamp])
}

model Recommendation {
  id                 String                  @id @default(cuid())
  launchId           String
  persona            Persona
  verdict            Verdict
  scoreAtEntry       Int
  priceAtEntry       Float
  liquidityAtEntry   Float?
  marketCapAtEntry   Float?
  rationaleJson      String
  issuedAt           DateTime                @default(now())
  evaluationStatus   String                  @default("pending")
  evaluatedAt        DateTime?
  launch             Launch                  @relation(fields: [launchId], references: [id], onDelete: Cascade)
  outcomes           RecommendationOutcome[]

  @@index([launchId, persona, issuedAt])
}

model RecommendationOutcome {
  id               String          @id @default(cuid())
  recommendationId String
  evaluationWindow String
  priceChangePct   Float
  maxUpsidePct     Float
  maxDrawdownPct   Float
  outcomeLabel     String
  computedAt       DateTime        @default(now())
  recommendation   Recommendation  @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@unique([recommendationId, evaluationWindow])
}

model Alert {
  id          String   @id @default(cuid())
  launchId    String
  alertType   String
  title       String
  body        String
  severity    Severity @default(info)
  payloadJson String?
  deliveredTo String?
  createdAt   DateTime @default(now())
  launch      Launch   @relation(fields: [launchId], references: [id], onDelete: Cascade)
  deliveries  AlertDelivery[]

  @@index([launchId, createdAt])
}

model UserProfile {
  id                  String               @id @default(cuid())
  walletAddress       String               @unique
  displayName         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  telegramConnections TelegramConnection[]
  alertPreferences    AlertPreference[]
  alertDeliveries     AlertDelivery[]
}

model TelegramConnection {
  id              String      @id @default(cuid())
  userProfileId   String
  chatId          String      @unique
  username        String?
  firstName       String?
  status          String      @default("connected")
  connectedAt     DateTime    @default(now())
  disconnectedAt  DateTime?
  userProfile     UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId, status])
}

model AlertPreference {
  id                String      @id @default(cuid())
  userProfileId     String
  channel           String      @default("telegram")
  enabled           Boolean     @default(true)
  personasJson      String      @default("[\"momentum\"]")
  verdictsJson      String      @default("[\"enter\"]")
  minimumScore      Int         @default(60)
  minimumLiquidity  Float?
  protocolsJson     String?
  maxAlertsPerHour  Int         @default(6)
  quietHoursJson    String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  userProfile       UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId, channel, enabled])
}

model AlertDelivery {
  id             String      @id @default(cuid())
  alertId        String
  launchId       String
  userProfileId  String
  channel        String
  destination    String
  status         String      @default("pending")
  errorMessage   String?
  deliveredAt    DateTime?
  createdAt      DateTime    @default(now())
  alert          Alert       @relation(fields: [alertId], references: [id], onDelete: Cascade)
  launch         Launch      @relation(fields: [launchId], references: [id], onDelete: Cascade)
  userProfile    UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([alertId, userProfileId, channel, destination])
  @@index([userProfileId, createdAt])
  @@index([channel, status, createdAt])
}

model LaunchMemo {
  id              String   @id @default(cuid())
  launchId        String
  scoreAtMemo     Int
  verdictAtMemo   Verdict
  reasonsJson     String
  headline        String?
  bull            String
  bear            String
  verdict         String
  confidence      Int
  modelUsed       String
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  cacheReadTokens Int      @default(0)
  generatedAt     DateTime @default(now())
  launch          Launch   @relation(fields: [launchId], references: [id], onDelete: Cascade)

  @@index([launchId, generatedAt])
}

model McpApiKey {
  id         String    @id @default(cuid())
  keyHash    String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model WorkerHeartbeat {
  workerKey                 String   @id
  chainName                 String
  streamUrl                 String
  startedAt                 DateTime
  heartbeatAt               DateTime
  trackedProtocolCount      Int
  trackedPairCount          Int
  pairCandleCandidateCount  Int
  tokenCandleCandidateCount Int
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

// Normalized operational/incident events for the ops surface (read by Halo).
// Emitted best-effort by the worker and ops-runner; never on the hot path.
model OperationalEvent {
  id              String               @id @default(cuid())
  type            OperationalEventType
  severity        Severity             @default(info)
  subsystem       String // worker | ingestion | analyst | telegram | ops-runner | deploy
  title           String
  summary         String
  metadataJson    String?
  actionRequestId String?
  createdAt       DateTime             @default(now())

  @@index([type, createdAt])
  @@index([subsystem, createdAt])
  @@index([severity, createdAt])
}

// Deploy history. The worker self-records on boot from a baked git SHA; the web
// app self-records from Vercel build env; the ops-runner records on rollback.
model DeployEvent {
  id           String   @id @default(cuid())
  gitSha       String
  shortSha     String
  service      String   @default("jaguar-worker") // jaguar-worker | jaguar-web
  source       String   @default("worker_boot") // worker_boot | vercel_build | ops_runner_rollback | manual
  previousSha  String?
  detectedAt   DateTime @default(now())
  metadataJson String?

  @@index([service, detectedAt])
  @@index([gitSha])
}

// Approval-gated action requests. Halo proposes; an operator approves; the
// VPS-side ops-runner claims approved rows, executes, and writes results back.
model ActionRequest {
  id          String              @id @default(cuid())
  actionType  ActionType
  status      ActionRequestStatus @default(proposed)
  riskLevel   ActionRiskLevel     @default(medium)
  title       String
  reason      String
  payloadJson String?
  proposedBy  String // "halo"
  resolvedBy  String?
  resultJson  String?
  createdAt   DateTime            @default(now())
  approvedAt  DateTime?
  rejectedAt  DateTime?
  startedAt   DateTime? // ops-runner claimed -> executing
  completedAt DateTime? // executed | failed
  updatedAt   DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([actionType, status])
}
